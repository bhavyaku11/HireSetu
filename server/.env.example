# ─────────────────────────────────────────────────────────────────────────────
# HireSetu Backend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Environment & Server
NODE_ENV=production
PORT=8080

# Aiven MySQL 8.4 Database Connection
# On Aiven, default database is 'defaultdb' and SSL mode is REQUIRED.
DB_HOST=your-mysql-service.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_aiven_db_password
DB_NAME=defaultdb

# Database SSL / TLS Settings (Aiven requires SSL)
DB_SSL=true
# Optional: Paste Aiven Project CA Certificate PEM content (single line or standard PEM)
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Or specify path to downloaded ca.pem file:
# DB_SSL_CA_PATH=./ca.pem
# Optional: Set to false ONLY during initial connection verification if CA cert is pending:
# DB_SSL_REJECT_UNAUTHORIZED=true

# Authentication & Security
# Generate a strong 64+ char random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_production_jwt_secret_here

# Frontend Application Origin (Used for CORS)
CLIENT_URL=https://hire-setu.vercel.app

# Google OAuth 2.0 (Optional — Required if using Google Sign-In)
# Must match Client ID configured in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Anthropic Claude API Key (Optional — Gracefully degrades if omitted)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

